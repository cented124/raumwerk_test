        "phone_required": {
          "default": false,
          "title": "Phone Required",
          "type": "boolean"
        }
      },
      "title": "FormTargets",
      "type": "object"
    },
    "FrontendBrief": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "default": "Eigentümer, Kauf- und Mietinteressenten",
          "title": "Audience",
          "type": "string"
        },
        "style": {
          "default": "Klar, hochwertig, zugänglich und persönlich",
          "title": "Style",
          "type": "string"
        },
        "wishes": {
          "default": "",
          "title": "Wishes",
          "type": "string"
        }
      },
      "title": "FrontendBrief",
      "type": "object"
    },
    "LayoutTheme": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "default": "#f7f9fa",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Background",
          "type": "string"
        },
        "foreground": {
          "default": "#142736",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Foreground",
          "type": "string"
        },
        "hero_layout": {
          "default": "cover",
          "enum": [
            "cover",
            "split"
          ],
          "title": "Hero Layout",
          "type": "string"
        },
        "card_layout": {
          "default": "grid",
          "enum": [
            "grid",
            "list"
          ],
          "title": "Card Layout",
          "type": "string"
        },
        "radius": {
          "default": 0,
          "maximum": 32,
          "minimum": 0,
          "title": "Radius",
          "type": "integer"
        },
        "content_width": {
          "default": 1280,
          "maximum": 1600,
          "minimum": 960,
          "title": "Content Width",
          "type": "integer"
        },
        "spacing": {
          "default": "normal",
          "enum": [
            "compact",
            "normal",
            "generous"
          ],
          "title": "Spacing",
          "type": "string"
        },
        "heading_scale": {
          "default": 1,
          "maximum": 1.3,
          "minimum": 0.8,
          "title": "Heading Scale",
          "type": "number"
        }
      },
      "title": "LayoutTheme",
      "type": "object"
    },
